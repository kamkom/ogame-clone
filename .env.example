# Copy to .env to override. All values are validated once at startup (see server/config.ts).

# Port the Fastify server listens on.
PORT=3000

# Host to bind. Defaults to loopback so the game is not exposed to the network.
HOST=127.0.0.1

# SQLite database file. Its parent directory is created on first start.
DB_PATH=./data/ogame.sqlite

# Universe Speed multiplier (x1 / x5 / x8 style). Must be a positive number.
UNIVERSE_SPEED=1

# Coordinate ranges for new Planets.
GALAXIES=9
SYSTEMS=499

# Whether the server also serves the built web app (dist/). "false" in dev, where Vite serves it.
SERVE_WEB=true
