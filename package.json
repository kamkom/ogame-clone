{
  "name": "ogame-clone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "cross-env SERVE_WEB=false node --experimental-strip-types --watch server/index.ts",
    "build": "vite build",
    "start": "npm run build && cross-env SERVE_WEB=true node --experimental-strip-types server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format",
    "test": "vitest run",
    "sandcastle": "npx tsx .sandcastle/main.mts"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@tanstack/react-query": "^5.62.7",
    "fastify": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
